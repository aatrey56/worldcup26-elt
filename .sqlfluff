[sqlfluff]
templater = dbt
dialect = duckdb
max_line_length = 100
# LT05 long lines (handled by dbt fmt); AL05 mis-fires on VALUES column aliases;
# ST06 (select column ordering), RF04 (keywords like `rank` as identifiers),
# AM05 (join style), RF02 (qualified refs, false-positives on VALUES/star) are
# opinionated and intentionally relaxed. Core layout + capitalization stay on.
exclude_rules = LT05,AL05,ST06,RF04,AM05,RF02

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower
