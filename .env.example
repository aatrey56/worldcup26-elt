# Copy to .env and fill in. .env is gitignored, never commit real values.

# football-data.org - ACTIVE ingestion source (free tier covers WC 2026)
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your_token_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
WC_COMPETITION=WC
WC_SEASON=2026

# API-Football (api-sports.io) - fallback only. Free tier is capped at seasons
# 2022-2024, so it cannot serve WC 2026. Kept for the 2022 World Cup or a paid plan.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
WC_LEAGUE_ID=1

# DuckDB warehouse file (local dev). Keep outside committed paths.
DUCKDB_PATH=/usr/local/airflow/include/data/warehouse.duckdb

# Slack failure alerts (Phase 3). Generate an incoming webhook URL in Slack.
SLACK_WEBHOOK_URL=
