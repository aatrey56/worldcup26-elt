# Copy to .env and fill in. .env is gitignored, never commit real values.

# API-Football (api-sports.io) - primary ingestion source
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Backup source (football-data.org) - optional
FOOTBALL_DATA_KEY=

# DuckDB warehouse file (local dev). Keep outside committed paths.
DUCKDB_PATH=/usr/local/airflow/include/data/warehouse.duckdb

# Slack failure alerts (Phase 3). Generate an incoming webhook URL in Slack.
SLACK_WEBHOOK_URL=

# World Cup competition identifiers - CONFIRM from the live API in Phase 1, do not assume.
WC_LEAGUE_ID=
WC_SEASON=2026
